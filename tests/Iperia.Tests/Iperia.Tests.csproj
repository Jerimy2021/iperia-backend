<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los tests leen la matriz IPERC real del repo. -->
    <Content Include="..\..\config\iperc_matrix.json" Link="config\iperc_matrix.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iperia.Api\Iperia.Api.csproj" />
    <ProjectReference Include="..\..\src\Iperia.Application\Iperia.Application.csproj" />
    <ProjectReference Include="..\..\src\Iperia.Domain\Iperia.Domain.csproj" />
    <ProjectReference Include="..\..\src\Iperia.Infrastructure\Iperia.Infrastructure.csproj" />
  </ItemGroup>

</Project>
